limit_req_zone $binary_remote_addr zone=handover_api:10m rate=30r/m;

upstream handover_frontends {
    # Sticky sessions keep Streamlit WebSocket state with one frontend.
    ip_hash;
    server handover_app_a:8501;
    server handover_app_b:8501;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 25m;
    limit_req zone=handover_api burst=20 nodelay;

    location / {
        proxy_pass http://handover_frontends;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
